<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  LEÇON FXML #2 — BorderPane et TableView
  ─────────────────────────────────────────
  • BorderPane divise l'écran en 5 zones : top / bottom / left / right / center.
    La zone center prend tout l'espace disponible — idéale pour une TableView.
  • VBox.vgrow="ALWAYS" → indique à la VBox parente de donner tout l'espace
    vertical disponible à ce nœud (équivalent Java : VBox.setVgrow(node, Priority.ALWAYS)).
  • Les colonnes de la TableView sont déclarées dans le controller (pas ici)
    car elles nécessitent des lambdas Java pour les setCellValueFactory.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.StudentController"
            styleClass="main-root"
            prefWidth="900" prefHeight="600">

    <!-- EN-TÊTE -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="14" bottom="14" left="20" right="20"/></padding>
            <!--
              HBox.hgrow="ALWAYS" → pousse les éléments suivants vers la droite.
              C'est l'équivalent d'un "spacer" flexible.
            -->
            <Label text="Mes Cours" styleClass="header-title" HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" styleClass="header-subtitle"/>
            <Button text="Déconnexion" onAction="#onDeconnexion" styleClass="logout-btn"/>
        </HBox>
    </top>

    <!-- TABLEAU PRINCIPAL -->
    <center>
        <VBox spacing="0">
            <padding><Insets top="16" bottom="0" left="16" right="16"/></padding>
            <TableView fx:id="coursTable" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Aucun cours trouvé."/></placeholder>
            </TableView>
        </VBox>
    </center>

    <!-- BARRE D'ACTIONS EN BAS -->
    <bottom>
        <HBox styleClass="action-bar" alignment="CENTER_LEFT" spacing="10">
            <padding><Insets top="12" bottom="12" left="16" right="16"/></padding>
            <Button text="Voir les supports"    onAction="#onVoirSupports" styleClass="action-btn"/>
            <Button text="Abandonner ce cours"  onAction="#onAbandonner"   styleClass="danger-btn"/>
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>
